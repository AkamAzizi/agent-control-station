{
  "name": "agent-control-station",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/cli.ts serve",
    "start": "tsx src/cli.ts serve",
    "cli": "tsx src/cli.ts",
    "build": "tsc --noEmit && pnpm --filter @agent-station/web build",
    "typecheck": "tsc --noEmit && pnpm --filter @agent-station/web typecheck",
    "test": "tsx --test test/*.test.ts",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "format": "prettier --write src apps/web/src test docs README.md",
    "format:check": "prettier --check src apps/web/src test docs README.md"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@fastify/static": "^8.3.0",
    "fastify": "5.12.3",
    "typescript": "5.9.3",
    "typebox": "1.3.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.6",
    "prettier": "3.9.6"
  }
}
